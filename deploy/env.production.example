# Production .env template for VPS deployment of autohub.id.vn
# Copy to /opt/apps/Do_An_Deploy/AutoHub/.env on the VPS and replace placeholders.
# DO NOT commit the real .env with secrets to Git.

# ── SQL Server SA password (>=8 chars; A-Z + a-z + 0-9 + special) ──
# Generate: openssl rand -base64 18 | tr -d '/+=' | head -c 24
# Then append something like '!Aa1' to satisfy complexity.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD!Aa1

# ── JWT signing key (Base64, decoded length >= 32 bytes for HS256) ──
# Generate: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_BASE64_KEY

# ── CORS + frontend base URL (must match the HTTPS origins users hit) ──
APP_CORS_ALLOWED_ORIGINS=https://autohub.id.vn,https://www.autohub.id.vn
FRONTEND_URL=https://autohub.id.vn

# ── Mail (Gmail App Password, NOT the login password) ──
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Bootstrap admin on first start (delete or blank password after first login) ──
APP_ADMIN_SEED_EMAIL=admin@autohub.id.vn
APP_ADMIN_SEED_PASSWORD=admin123@

# ── Hibernate schema strategy: `update` first run, then change to `validate` ──
JPA_DDL_AUTO=update

# ── Payment / bank transfer info (shown on QR & bank-info page) ──
PAYMENT_BANK_CODE=TCB
PAYMENT_BANK_NAME=Techcombank
PAYMENT_BANK_ACCOUNT_NUMBER=your_account_number
PAYMENT_BANK_ACCOUNT_NAME=YOUR FULL NAME

# ── Optional: Gemini AI key (leave blank if unused) ──
# GEMINI_API_KEY=

# GPLX: tu dong duyet khi user upload du CCCD + GPLX (ca hai PENDING).
# Dat false neu muon admin duyet thu cong tai Quan ly xe thue -> Duyet GPLX.
APP_KYC_AUTO_APPROVE=true

# ── Docker publish ports (127.0.0.1 only — not exposed on the public internet) ──
# HTTPS traffic: browser → host Nginx → WEB_PORT below → container Nginx → api:8080 on the Compose network.
# So changing API_PORT/MSSQL_PORT does NOT break the domain; it only affects tools that curl localhost:PORT from the VPS.
# On Linux VPS, 8080/1433 are usually free — set explicitly so ops/scripts match conventional ports.
API_PORT=8080
WEB_PORT=3000
MSSQL_PORT=1433
