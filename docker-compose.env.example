# Copy to .env in same directory as docker-compose.yml
# docker compose reads .env automatically

# SA password — MUST be strong (Linux image): >=8 chars + at least 3/4 groups A-Z, a-z, 0-9, special chars.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# JWT (Base64, decode to >= 32 bytes for HS256)
JWT_KEY=QXV0b0h1YkBSZW50QUNhciNTZWNyZXRLZXkhMjAyNCQ=

# Browser origins (CORS) — must match URLs you open the SPA from
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Admin seed on startup (leave APP_ADMIN_SEED_PASSWORD empty to disable)
# APP_ADMIN_SEED_EMAIL=admin@autohub.local
# APP_ADMIN_SEED_PASSWORD=12345678

# Only for local frontend dev (npm run dev). Docker build uses Nginx proxy.
# VITE_API_URL=http://localhost:8080

# Mail (Gmail: use App Password, not login password)
# MAIL_USERNAME=youraccount@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# FRONTEND_URL=http://localhost:3000

# Optional
# API_PORT=8080
# WEB_PORT=3000
# MSSQL_PORT=1433
# JPA_DDL_AUTO=update
