# Sao chép thành file .env cùng thư mục với docker-compose.yml
# docker compose tự đọc .env

# Mật khẩu SA — BẮT BUỘC đủ mạnh (image Linux): ≥8 ký tự + ít nhất 3/4 nhóm A-Z, a-z, 0-9, ký tự đặc biệt.
# Không dùng: 12345678, admin, sa123 — log sẽ báo "Password validation failed" và db thoát mã 255.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# JWT (Base64, giống jwt.key khi dev)
JWT_KEY=QXV0b0h1YkBSZW50QUNhciNTZWNyZXRLZXkhMjAyNCQ=

# Origin trình duyệt (CORS) — phải khớp URL bạn mở SPA (WEB_PORT mặc định 3001; override dev + VITE_API_URL gọi thẳng :8081 cần origin này)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Mỗi lần container api khởi động: tạo/cập nhật admin + mật khẩu (Compose có mặc định 12345678). Production: đặt APP_ADMIN_SEED_PASSWORD= để tắt.
# APP_ADMIN_SEED_EMAIL=admin@autohub.local
# APP_ADMIN_SEED_PASSWORD=12345678

# Chỉ dùng khi chạy frontend bằng npm run dev (frontend/.env). Docker Compose build service web luôn dùng base URL rỗng + Nginx proxy /api.
# VITE_API_URL=http://localhost:8081

# ─── Gửi email (OTP quên mật khẩu, v.v.) — BẮT BUỘC nếu cần nhận OTP qua mail khi chạy Docker ───
# Gmail: bật xác minh 2 bước → Tạo "Mật khẩu ứng dụng" (App Password) tại https://myaccount.google.com/apppasswords
# Gán vào đây (không có dấu cách thừa). Không dùng mật khẩu đăng nhập Gmail thường.
# MAIL_USERNAME=youraccount@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# URL trang web (trong email OTP) — trùng cổng bạn mở trình duyệt, ví dụ Docker web mặc định:
# FRONTEND_URL=http://localhost:3000

# Tuỳ chọn
# API_PORT=8081
# WEB_PORT=3000
# MSSQL_PORT=1433
# JPA_DDL_AUTO=validate
# Đổi thành update nếu cần Hibernate tự sửa schema (không khuyến nghị khi đã dùng script SQL đầy đủ)
