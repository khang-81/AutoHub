# Copy to .env in same directory as docker-compose.yml
# docker compose reads .env automatically

# SA password — MUST be strong (Linux image): >=8 chars + at least 3/4 groups A-Z, a-z, 0-9, special chars.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# JWT (Base64, decode to >= 32 bytes for HS256)
JWT_KEY=QXV0b0h1YkBSZW50QUNhciNTZWNyZXRLZXkhMjAyNCQ=

# Browser origins (CORS) — must match URLs you open the SPA from
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8088,http://127.0.0.1:8088

# Admin seed on startup (set APP_ADMIN_SEED_PASSWORD empty to disable bootstrap)
# APP_ADMIN_SEED_EMAIL=admin@autohub.id.vn
# APP_ADMIN_SEED_PASSWORD=admin123@

# Only for local frontend dev (npm run dev). Docker build uses Nginx proxy.
# VITE_API_URL=http://localhost:8088

# Mail (Gmail: use App Password, not login password)
# MAIL_USERNAME=youraccount@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# FRONTEND_URL=http://localhost:3000

# Optional — host port mapped to Spring (container still listens on 8080). Default in compose is 8088 if 8080 is busy.
# API_PORT=8088
# WEB_PORT=3000
# Host port for tools on your machine (API uses sqlserver:1433 inside Compose). On Windows, 1433 is often blocked — default is 14330 in docker-compose.yml.
# MSSQL_PORT=14330
# JPA_DDL_AUTO=update
