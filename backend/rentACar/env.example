# Copy to .env on server or export each variable. Run with: SPRING_PROFILES_ACTIVE=prod
# Docker: use the .env at repo root (for docker compose).

# --- Required (prod) — SQL Server (Docker / VM) ---
SPRING_DATASOURCE_URL=jdbc:sqlserver://sqlserver:1433;databaseName=autohub;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JWT — Base64, decode to >= 32 bytes (HS256)
JWT_KEY=

# CORS — comma-separated origins (no trailing path)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Optional ---
# APP_ADMIN_SEED_EMAIL=admin@autohub.id.vn
# APP_ADMIN_SEED_PASSWORD=admin123@
# APP_ADMIN_SEED_PASSWORD=
# JWT_EXPIRATION=86400000
# MAIL_USERNAME=
# MAIL_PASSWORD=
# GEMINI_API_KEY=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# APP_UPLOAD_ROOT=/var/data/rentacar/uploads
# PORT=8080
# JPA_DDL_AUTO=validate
