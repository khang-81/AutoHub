# Sao chép thành .env trên server hoặc export từng biến (Spring Boot đọc biến môi trường hệ thống).
# Chạy backend: SPRING_PROFILES_ACTIVE=prod
# Docker: dùng docker-compose.env.example ở thư mục gốc repo (copy thành .env cho docker compose).

# --- Bắt buộc (prod) — SQL Server (Docker / VM) ---
SPRING_DATASOURCE_URL=jdbc:sqlserver://HOST:1433;databaseName=autohub;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Hoặc Supabase / PostgreSQL (Render + Vercel) ---
# Trong Supabase: Settings → Database → Connection string → URI (port 5432, direct).
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# JWT — Base64, decode ra ≥ 32 byte (HS256)
JWT_KEY=

# CORS — danh sách origin, phân cách bằng dấu phẩy (không có path)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Tuỳ chọn ---
# Đồng bộ admin mỗi lần khởi động (để trống APP_ADMIN_SEED_PASSWORD = tắt). Docker Compose mặc định bật.
# APP_ADMIN_SEED_EMAIL=admin@autohub.local
# APP_ADMIN_SEED_PASSWORD=
# JWT_EXPIRATION=86400000
# MAIL_USERNAME=
# MAIL_PASSWORD=
# GEMINI_API_KEY=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# APP_UPLOAD_ROOT=/var/data/rentacar/uploads
# PORT=8081
# JPA_DDL_AUTO=validate
# Lần đầu tạo schema: JPA_DDL_AUTO=update
